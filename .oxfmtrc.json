{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "es5",
  "singleQuote": false,
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "sortImports": {
    "internalPattern": ["@/"]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "pnpm-lock.yaml",
    "dist",
    "build",
    ".next",
    "out",
    ".expo",
    ".expo-shared",
    "ios/Pods",
    "ios/build",
    "*.xcworkspace",
    "*.xcodeproj",
    "android/app/build",
    "android/build",
    "*.gradle",
    "*.properties",
    ".cache",
    ".turbo",
    ".env",
    ".env.local",
    ".env.*.local",
    "*.log",
    "npm-debug.log*",
    ".DS_Store",
    "*.pem",
    ".vscode",
    ".idea",
    "*.pbxproj",
    "*.xcscheme",
    "ios",
    "android",
    "tooling/oxlint-plugins/anti-slop",
    ".agents",
    ".claude",
    ".codex",
    ".cursor",
    ".gemini",
    ".kiro",
    ".opencode",
    ".zed"
  ]
}
