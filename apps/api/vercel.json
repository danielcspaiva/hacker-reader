{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@12.6.0 install --frozen-lockfile --filter @hn/api...",
  "buildCommand": "npx --yes pnpm@12.6.0 run build",
  "crons": [
    {
      "path": "/api/cron/replies",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/alerts",
      "schedule": "*/10 * * * *"
    }
  ]
}
