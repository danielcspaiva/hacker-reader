# Upstash Redis (Vercel marketplace: Storage > Upstash > Redis). Injected
# automatically when you connect the store to the project.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# RevenueCat: project Settings > API keys > Secret API key (v1, read access is
# enough). Used to read a subscriber's `pro` entitlement.
REVENUECAT_SECRET_KEY=

# RevenueCat webhook: the exact Authorization header value you configure in
# Integrations > Webhooks, for example "Bearer <random string>".
REVENUECAT_WEBHOOK_AUTH=

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=

# Optional: raises Expo push limits and enables enhanced security for push.
EXPO_ACCESS_TOKEN=

# AI summaries (Pro). Anthropic API key used by GET /api/v1/summaries/story/:id.
# Without it the route answers 503 and the app shows a friendly error.
ANTHROPIC_API_KEY=

# Optional: model for summaries (default claude-sonnet-5-5, $2/$10 per MTok).
SUMMARY_MODEL=

# Optional: global daily token budget (input + output, UTC day). Over budget the
# route answers 503 until the next day. Default 5000000 (about 125 summaries).
SUMMARY_DAILY_TOKEN_BUDGET=
