# Sentry configuration
EXPO_PUBLIC_SENTRY_DSN=https://your-public-key@your-sentry-instance.ingest.sentry.io/your-project-id
SENTRY_AUTH_TOKEN=replace-with-your-sentry-auth-token

# PostHog analytics
EXPO_PUBLIC_POSTHOG_API_KEY=replace-with-your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Hacker Reader Pro (optional; leave blank to hide Pro in the app)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=replace-with-your-revenuecat-ios-public-key
EXPO_PUBLIC_API_URL=https://your-api-project.vercel.app
