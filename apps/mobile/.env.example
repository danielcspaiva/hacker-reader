# DO NOT COMMIT .env.local - This is just an example file
# Copy this file to .env.local and fill in your actual values

# Sentry DSN for error tracking
# Get this from: https://sentry.io/settings/hacker-reader/projects/app/keys/
EXPO_PUBLIC_SENTRY_DSN=https://your-public-key@your-sentry-instance.ingest.sentry.io/your-project-id

# Sentry Auth Token (for uploading source maps during builds)
# Get this from: https://sentry.io/settings/account/api/auth-tokens/
# IMPORTANT: This token has write access - NEVER commit it to version control
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
