{
  "expo": {
    "name": "Hacker Reader",
    "slug": "hn-client",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/ybook.png",
    "scheme": "hnclient",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.danielcspaiva.hnclient",
      "buildNumber": "26",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/ybook.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFBF7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.danielcspaiva.hnclient"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ybook.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F0EC",
          "dark": {
            "image": "./assets/images/ybook.png",
            "backgroundColor": "#17130F"
          }
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "app",
          "organization": "hacker-reader"
        }
      ],
      "expo-localization",
      "expo-web-browser",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.danielcspaiva.hnclient.HackerReaderWidgets",
          "groupIdentifier": "group.com.danielcspaiva.hnclient",
          "enablePushNotifications": false,
          "frequentUpdates": false,
          "widgets": [
            {
              "name": "HNTopStoriesWidget",
              "displayName": "HN Stories",
              "description": "View stories from Hacker News",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ],
                "contentMarginsDisabled": false,
                "initialLayout": "widgets/HNTopStoriesWidget.tsx",
                "configuration": {
                  "title": "Stories",
                  "description": "Choose which Hacker News stories to show",
                  "parameters": {
                    "category": {
                      "title": "Category",
                      "type": "enum",
                      "values": [
                        { "name": "Top", "value": "top" },
                        { "name": "Best", "value": "best" },
                        { "name": "New", "value": "new" },
                        { "name": "Ask HN", "value": "ask" },
                        { "name": "Show HN", "value": "show" },
                        { "name": "Jobs", "value": "jobs" }
                      ],
                      "default": "top"
                    }
                  }
                }
              }
            },
            {
              "name": "HNBookmarksWidget",
              "displayName": "HN Bookmarks",
              "description": "Your most recent bookmarked stories",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"],
                "contentMarginsDisabled": false,
                "initialLayout": "widgets/HNBookmarksWidget.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/with-widget-self-refresh",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.danielcspaiva.hnclient",
            "extensionBundleIdentifier": "com.danielcspaiva.hnclient.ShareExtension",
            "activationRule": {
              "supportsWebUrlWithMaxCount": 1,
              "supportsText": true
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5b8a8556-80c5-4cce-84e1-d87598b82461"
      }
    }
  }
}
