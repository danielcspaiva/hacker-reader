{
  "name": "@hn/mobile",
  "main": "expo-router/entry",
  "version": "1.3.0",
  "license": "MIT",
  "scripts": {
    "dev": "node -r ./scripts/raf-polyfill.cjs ../../node_modules/expo/bin/cli start",
    "start": "node -r ./scripts/raf-polyfill.cjs ../../node_modules/expo/bin/cli start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:widgets": "npx expo prebuild --platform ios && pnpm ios",
    "prebuild:ios": "npx expo prebuild --platform ios && pnpm sync-xcode-env",
    "prebuild:clean": "rm -rf ios && npx expo prebuild --platform ios && pnpm sync-xcode-env",
    "sync-xcode-env": "node ./scripts/sync-xcode-env.js",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "@expo/dom-webview": "~58.0.0",
    "@expo/metro-runtime": "~58.0.2",
    "@expo/ui": "58.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-cookies/cookies": "^6.2.1",
    "@sentry/react-native": "^8.26.0",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.90.5",
    "expo": "58.0.0-preview.2",
    "expo-application": "~58.0.1",
    "expo-build-properties": "~58.0.2",
    "expo-constants": "~58.0.2",
    "expo-dev-client": "~58.0.2",
    "expo-device": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.1",
    "expo-glass-effect": "~58.0.0",
    "expo-haptics": "~58.0.1",
    "expo-image": "~58.0.2",
    "expo-linking": "~58.0.2",
    "expo-localization": "~58.0.0",
    "expo-router": "~58.0.3",
    "expo-secure-store": "~58.0.0",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.1",
    "expo-system-ui": "~58.0.1",
    "expo-web-browser": "~58.0.0",
    "posthog-react-native": "^4.10.6",
    "posthog-react-native-session-replay": "^1.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0-rc.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "~4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-user-interface-style": "^1.0.8",
    "react-native-web": "~0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-widget-extension": "^0.2.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.88.0-rc.0",
    "@types/react": "~19.2.15",
    "typescript": "~6.0.3"
  },
  "private": true,
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67",
